# Copia este archivo a .env y rellena los valores (no subas .env a git).

# Backend por defecto: openai | ollama
DSPY_LM_BACKEND=ollama

# OpenAI (LiteLLM; requiere OPENAI_API_KEY si usas openai)
OPENAI_API_KEY=
OPENAI_MODEL=openai/gpt-4o-mini

# Ollama:
# - Dentro del Dev Container / Compose → http://ollama:11434
# - Jupyter u otro proceso en el host → http://localhost:11434
OLLAMA_BASE_URL=http://ollama:11434
# Mismo nombre que `ollama list` (suele incluir :latest)
OLLAMA_MODEL=llama3.2:latest
