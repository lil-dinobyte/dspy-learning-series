# Copia este archivo a .env y rellena los valores (no subas .env a git).

# Backend: openai | ollama (ollama solo si lo tenés en el host con `ollama serve`)
DSPY_LM_BACKEND=openai

# OpenAI (LiteLLM; requiere OPENAI_API_KEY)
OPENAI_API_KEY=
OPENAI_MODEL=openai/gpt-4o-mini

# Ollama opcional en el host (no usa Docker):
# DSPY_LM_BACKEND=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:latest
